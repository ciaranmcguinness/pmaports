# Maintainer: Luca Weiss <luca@lucaweiss.eu>
pkgname=soc-qcom-sc7280
pkgdesc="Common package for Qualcomm SC7280/SM7325/QCM6490 devices"
pkgver=1
pkgrel=3
url="https://postmarketos.org"
license="BSD-3-Clause"
arch="aarch64"
options="!check !archcheck !tracedeps"
depends="
	bootmac
	firmware-qcom-adreno-a660
	linux-firmware-ath11k
	linux-firmware-qca
	msm-modem
	msm-modem-uim-selection
	pd-mapper
	swclock-offset
	tqftpserv
"
subpackages="
	$pkgname-hexagonrpcd-openrc:hexagonrpcd_openrc
	$pkgname-openrc
	$pkgname-qbootctl
	$pkgname-qbootctl-openrc:qbootctl_openrc
	$pkgname-unl0kr
	$pkgname-vulkan
"

source="
	10-unl0kr.conf
"

package() {
	mkdir -p "$pkgdir"
}

hexagonrpcd_openrc() {
	install_if="$pkgname-hexagonrpcd=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install $subpkgname.post-upgrade"
	depends="hexagonrpcd-openrc"

	mkdir -p "$subpkgdir"
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install $subpkgname.post-upgrade"
	depends="
		pd-mapper-openrc
		tqftpserv-openrc
		"

	mkdir -p "$subpkgdir"
}

qbootctl() {
	pkgdesc="Enable qbootctl mark-boot-successful service"
	depends="qbootctl"

	mkdir -p "$subpkgdir"
}

qbootctl_openrc() {
	install_if="$pkgname-qbootctl=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install $subpkgname.post-upgrade"
	depends="qbootctl-openrc"

	mkdir -p "$subpkgdir"
}

unl0kr() {
	install -Dm644 "$srcdir"/10-unl0kr.conf -t \
		"$pkgdir"/etc/unl0kr.conf.d
}

vulkan() {
	pkgdesc="Vulkan support for freedreno"
	install_if="$pkgname vulkan-loader"
	depends="mesa-vulkan-freedreno"
	mkdir "$subpkgdir"
}

sha512sums="
f700af3145b79d1ef9edfb22982899b25cabfb212f9620dcbd3a2e6f44b5ad591e0a66056c6fcd66c3fde89a2b5f551e8a8fe2e65cf0e2a48adec57c027d7825  10-unl0kr.conf
"